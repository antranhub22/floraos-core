      "required": [
        "orderReceivedAt",
        "latestStartProductionAt",
        "targetQcReadyAt",
        "targetDispatchAt",
        "targetDeliveryAt"
      ],
      "additionalProperties": false
    },
    "materialCheck": {
      "type": "object",
      "properties": {
        "totalStems": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "availableStems": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "hasMissingFlowers": {
          "type": "boolean"
        },
        "missingFlowersList": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "totalStems",
        "availableStems",
        "hasMissingFlowers",
        "missingFlowersList"
      ],
      "additionalProperties": false
    },
    "validationNotes": {
      "type": "string"
    }
  },
  "required": [
    "coordinationId",
    "stage",
    "riskLevel",
    "isFeasible",
    "timeline",
    "materialCheck",
    "validationNotes"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "coordinationId": "a1b2c3d4-e29b-41d4-a716-446655440001",
      "stage": "PLANNING",
      "riskLevel": "NORMAL",
      "isFeasible": true,
      "timeline": {
        "orderReceivedAt": "2026-09-25T10:00:00.000Z",
        "latestStartProductionAt": "2026-09-25T15:30:00.000Z",
        "targetQcReadyAt": "2026-09-25T16:15:00.000Z",
