  "type": "object",
  "properties": {
    "taskType": {
      "description": "Bỏ trống: có nhạc → AUDIO_MIX, không → VOICEOVER",
      "type": "string",
      "enum": [
        "VOICEOVER",
        "MUSIC_SELECT",
        "AUDIO_MIX",
        "VOICE_CLONE"
      ]
    },
    "scenes": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sceneIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          },
          "voiceScript": {
            "type": "string",
            "maxLength": 600
          },
          "targetDurationSeconds": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 60
          }
        },
        "required": [
          "sceneIndex",
          "voiceScript",
          "targetDurationSeconds"
        ]
      }
    },
    "totalDurationSeconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 300
    },
    "voiceId": {
      "type": "string",
      "maxLength": 80
    },
    "voiceCloneId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "providerKey": {
      "description": "google_cloud và local_fallback bị loại khỏi bản thương mại — máy chủ trả 422",
      "type": "string",
      "enum": [
        "openai",
        "elevenlabs",
        "minimax",
        "edge_tts",
        "google_cloud",
        "local_fallback"
      ]
    },
    "qualityTier": {
      "type": "string",
      "enum": [
        "standard",
        "hd",
        "premium"
      ]
    },
    "musicTrackId": {
      "type": "string",
      "maxLength": 80
    },
    "musicMood": {
      "type": "string",
      "enum": [
        "romantic",
        "upbeat",
        "chill",
        "warm",
        "luxury",
        "none"
      ]
    },
    "topicAngleCategory": {
      "type": "string",
      "maxLength": 60
    },
    "musicProvider": {
      "description": "Bỏ trống = nhạc AI theo thứ tự tiệm (bài musicTrackId là dự phòng); library = chỉ bài thư viện (0 credit)",
      "type": "string",
      "enum": [
        "elevenlabs_music",
        "library"
      ]
    },
    "scenePlanId": {
      "description": "Kịch bản sản xuất tổng (Chặng 05) mà bản âm thanh thực thi",
      "type": "string",
      "maxLength": 160
    },
    "scenePlanRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "scenes"
  ],
  "examples": [
    {
      "taskType": "AUDIO_MIX",
      "scenes": [
        {
          "sceneIndex": 1,
