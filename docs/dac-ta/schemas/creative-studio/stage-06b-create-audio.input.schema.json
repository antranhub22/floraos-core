{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage-06b-create-audio.input.schema.json",
  "title": "Chặng 06b — CREATE · Khu vực C: Giọng đọc & nhạc nền — Đầu vào",
  "description": "Bốn tác vụ thật: VOICEOVER, MUSIC_SELECT, AUDIO_MIX, VOICE_CLONE. Nhà cung cấp trước (25/09/2026): giọng theo thứ tự tiệm, nhạc nền AI (ElevenLabs Music) với bài thư viện làm dự phòng; musicProvider=library = 0 credit phần nhạc. Kết quả cuối (audio_storage_key) đọc từ job khi COMPLETED.",
  "x-floraos": {
    "stageId": "06b",
    "stage": 6,
    "code": "CREATE_AUDIO",
    "endpoint": {
      "method": "POST",
      "path": "/api/v1/audio/jobs",
      "capability": "I1",
      "idempotencyKey": true
    },
    "source": "src/modules/creative-production/contracts/stage-06b-create-audio.ts",
    "direction": "input",
    "generated": "SINH TỰ ĐỘNG — không sửa tay. Sửa zod ở tệp nguồn rồi chạy `npm run gen:schemas:creative`."
