{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage-12-measure.output.schema.json",
  "title": "Chặng 12 — MEASURE: Đo lường hiệu quả kinh doanh — Đầu ra",
  "description": "Đơn/doanh thu của sản phẩm (bỏ DRAFT/CANCELLED), hội thoại, số kênh từ content_metrics; null = chưa có số; caveats hiển thị nguyên văn.",
  "x-floraos": {
    "stageId": "12",
