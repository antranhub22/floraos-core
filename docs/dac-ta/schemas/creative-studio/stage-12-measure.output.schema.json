              "type": [
                "number",
                "null"
              ]
            },
            "impressions": {
              "description": "null = chưa có số",
              "type": [
                "number",
                "null"
              ]
            },
            "engagement": {
              "description": "null = chưa có số",
              "type": [
                "number",
                "null"
              ]
            },
            "clicks": {
              "description": "null = chưa có số",
              "type": [
                "number",
                "null"
              ]
            },
            "conversions": {
              "description": "null = chưa có số",
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "linkedPosts",
            "postsWithData",
            "reach",
            "impressions",
            "engagement",
            "clicks",
            "conversions"
