            },
            "revenueVnd": {
              "type": "number"
            }
          },
          "required": [
            "count",
            "quantity",
            "revenueVnd"
          ],
          "additionalProperties": false
        },
        "conversations": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "channel": {
          "type": "object",
          "properties": {
            "linkedPosts": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
