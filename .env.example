DATABASE_URL="postgresql://floraos:floraos@localhost:5432/floraos"

# Khoá nhà cung cấp AI — khoá nền tảng, không phải khoá của tổ chức (D2).
# Không bao giờ đi qua trình duyệt, không bao giờ nằm trong bảng nào.
OPENAI_API_KEY=

# Kho tệp
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Bí mật ký phiên
SESSION_SECRET=

# Bí mật ký token máy gọi máy — Integration Layer (P7, YC-T8)
INTEGRATION_TOKEN_SECRET=

# Bí mật ký JWT phiên liên-app — Unified Shell SSO (B1). LocalBudd và
# SocialFlow xác minh JWT bằng CHÍNH khoá này (khoá đối xứng, chia sẻ giữa ba
# repo qua biến môi trường triển khai, không qua mã nguồn).
SSO_SESSION_SECRET=

# URL của SocialFlow/LocalBudd — dùng cho proxy server-side (P15+).
# Dashboard core gọi sibling qua proxy để tránh CORS trình duyệt.
# Ba cổng cục bộ: floraos-core 3100 / LocalBudd 3000 / SocialFlow 8000
SOCIALFLOW_URL=http://localhost:8000
LOCALBUDD_URL=http://localhost:3000

# URL công khai của SocialFlow/LocalBudd — dùng cho thẻ "mở sang" ở màn Trải
# nghiệm. Để trống khi chưa có bản triển khai thật.
NEXT_PUBLIC_SOCIALFLOW_URL=http://localhost:8000
NEXT_PUBLIC_LOCALBUDD_URL=http://localhost:3000
