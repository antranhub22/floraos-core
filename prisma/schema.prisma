// Nguồn sự thật lược đồ của floraos-core.
// Worker Python đọc lược đồ sinh sẵn, không tự khai bảng (V2 mục 3.1).
//
// Luật bắt buộc với mọi model thêm vào đây:
//   1. Mọi bản ghi thuộc tenant mang organization_id, có index. Không ngoại lệ.
//   2. Đặt tên snake_case tiếng Anh.
//   3. generation_jobs tách ba trục: status / stage / result.
//
// `users` là bảng duy nhất không có organization_id — một người thuộc nhiều
// tổ chức qua `memberships`.
//
// Chuỗi kết nối không nằm trong tệp này. Prisma 7 đọc nó từ `prisma.config.ts`
// cho lệnh migrate, và từ driver adapter cho `PrismaClient`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Kiểu liệt kê ────────────────────────────────────────────────────────────
// Bộ giá trị của P1. Các enum còn lại (job_status, asset_kind, …) thêm ở pha
// sở hữu bảng tương ứng.

enum organization_type {
  EXPERIENCE
  SINGLE
  CHAIN
}

enum workspace_kind {
  EXPERIENCE
  PRODUCTION
}

enum membership_status {
  INVITED
  ACTIVE
  SUSPENDED
}

enum trial_status {
  ACTIVE
  EXHAUSTED
  EXPIRED
}

enum capability_scope {
  ORGANIZATION
  BRANCH
}

// Nền AI — đợt AI-1 (đặc tả 10). Sổ đăng ký năng lực và mô hình là dữ liệu
// cấp NỀN TẢNG, không mang organization_id; chính sách, sổ chi phí và điểm
// chấm thì thuộc tenant.

enum ai_mode {
  API
  SELF_HOST
  DETERMINISTIC
}

enum ai_privacy_level {
  PUBLIC
  SHOP
  SENSITIVE
}

enum ai_measure_state {
  CHUA_DO
  THU_NGHIEM
  SAN_XUAT
}

// ── Nền tảng đa tenant — P1 ─────────────────────────────────────────────────

model users {
  id            String   @id @default(uuid())
  email         String   @unique
  password_hash String?
  name          String?
  avatar_url    String?
  locale        String   @default("vi")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  memberships memberships[]
  sessions    sessions[]

  // Console Vận hành Nền tảng (P25) — độc lập với memberships, xem mục cuối tệp
  platform_operator platform_operators?
}

model sessions {
  id              String    @id @default(uuid())
  user_id         String
  token_hash      String    @unique
  organization_id String? // tổ chức đang hoạt động của phiên
  created_at      DateTime  @default(now())
  expires_at      DateTime
  revoked_at      DateTime?

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model organizations {
  id             String            @id @default(uuid())
  name           String
  slug           String            @unique
  type           organization_type @default(SINGLE)
  credit_balance Int               @default(0)
  credit_plan    String?
  settings       Json? // bảng công tắc cấp tổ chức, gồm cho_phep_tu_duyet
  created_at     DateTime          @default(now())
  updated_at     DateTime          @updatedAt

  // Khoá ngoại tới organizations mở lại ở P3 (TECHNICAL_DEBT #8) — bốn bảng
  // dưới đây là bốn bảng nợ đó; assets/generation_jobs/usage/audit_logs khai
  // khoá ngoại ngay từ khi tạo, không nợ.
  workspaces            workspaces[]
  branches              branches[]
  capability_overrides  capability_overrides[]
  memberships           memberships[]
  assets                assets[]
  generation_jobs       generation_jobs[]
  usage                 usage[]
  audit_logs            audit_logs[]
  business_profile      business_profiles?
  brand_profile         brand_profiles?
  products              products[]
  product_variants      product_variants[]
  product_images        product_images[]
  product_analyses      product_analyses[]
  product_inventory     product_inventory[]
  pricing_rules         pricing_rules[]
  integration_tokens    integration_tokens[]
  ai_policies           ai_policies[]
  ai_requests           ai_requests[]
  ai_evaluations        ai_evaluations[]
  occasions             occasions[]
  template_overrides    template_overrides[]
  catalog_links         catalog_links[]
  product_copies        product_copies[]
  content_metrics       content_metrics[]
  video_jobs            video_jobs[]
  orders                orders[]
  order_items           order_items[]
  order_assignments     order_assignments[]
  order_events          order_events[]
  customers             customers[]
  customer_occasions    customer_occasions[]
  customer_consents     customer_consents[]
  vouchers              vouchers[]
  chat_conversations         chat_conversations[]
  chat_messages              chat_messages[]
  chat_channel_integrations  chat_channel_integrations[]
  content_opportunities      content_opportunities[]
  product_analysis_runs      product_analysis_runs[]
  campaign_packages          campaign_packages[]
  content_drafts             content_drafts[]
  content_generations        content_generations[]
  voice_clones               voice_clones[]
  music_tracks               music_tracks[]
  partners                   partners[]
  order_coordinations        order_coordinations[]
  order_qc_records           order_qc_records[]
  order_exceptions           order_exceptions[]
}

model workspaces {
  id              String         @id @default(uuid())
  organization_id String
  name            String
  kind            workspace_kind @default(PRODUCTION)
  trial_count     Int            @default(0)
  trial_limit     Int?
  trial_reset_at  DateTime?
  trial_status    trial_status?
  created_at      DateTime       @default(now())

  organization organizations @relation(fields: [organization_id], references: [id])

  @@index([organization_id])
}

model branches {
  id              String   @id @default(uuid())
  organization_id String
  name            String
  code            String
  address         String?
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())

  organization organizations @relation(fields: [organization_id], references: [id])
  inventory    product_inventory[]

  @@unique([organization_id, code])
  @@index([organization_id])
}

model roles {
  id              String   @id @default(uuid())
  organization_id String? // null = vai hệ thống, dùng chung mọi tổ chức
  key             String // dieu_hanh · sale · dieu_phoi · experience_user
  name            String
  is_system       Boolean  @default(false)
  created_at      DateTime @default(now())

  capabilities role_capabilities[]

  @@unique([organization_id, key])
  @@index([organization_id])
}

/**
 * Bảng công tắc: mã năng lực nào đang bật cho một vai (đặc tả 02 mục 1, lớp
 * hai). Vai hệ thống (`organization_id = null` của chính `roles`) được nạp
 * sẵn từ bản mặc định trong `src/core/rbac/capability-catalog.ts` lúc
 * `ensureSystemRoles`. Vai riêng của tổ chức có switchboard của chính nó.
 *
 * Trần cứng (lớp ba) KHÔNG nằm ở đây — nó là hằng trong mã, xem
 * `src/core/rbac/capability-catalog.ts`. Một dòng bật ở bảng này cho một mã
 * đã bị trần cứng chặn vẫn không mở được năng lực đó.
 */
model role_capabilities {
  id              String           @id @default(uuid())
  role_id         String
  capability_code String // A1 … L6, xem đặc tả 02
  scope           capability_scope @default(ORGANIZATION)

  role roles @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([role_id, capability_code])
}

/**
 * Ngoại lệ theo tổ chức, đè lên switchboard của một vai hệ thống mà tổ chức
 * không sở hữu (`roles.organization_id = null`) nên không sửa trực tiếp
 * được. `allowed = true` bật thêm một mã; `allowed = false` tắt một mã đang
 * bật mặc định. Vai riêng của tổ chức không cần dùng bảng này — tổ chức sửa
 * thẳng `role_capabilities` của vai đó.
 *
 * Trần cứng vẫn cắt sau cùng: `allowed = true` cho một mã có trần cứng không
 * bao gồm vai đó không mở được năng lực (`YC-Q3`).
 */
model capability_overrides {
  id              String   @id @default(uuid())
  organization_id String
  role_id         String
  capability_code String
  allowed         Boolean
  updated_by      String
  updated_at      DateTime @updatedAt

  organization organizations @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, role_id, capability_code])
  @@index([organization_id])
}

model memberships {
  id              String            @id @default(uuid())
  organization_id String
  user_id         String
  role_id         String
  branch_id       String? // null = phạm vi toàn tổ chức
  status          membership_status @default(INVITED)
  invited_at      DateTime          @default(now())
  joined_at       DateTime?

  user         users         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  organization organizations @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, user_id])
  @@index([organization_id])
  @@index([user_id])
}

// ── Asset · Job · Usage · Audit — P3 ────────────────────────────────────────
// Đặc tả 07 mục 5–8. Bốn bảng dưới khai organization_id NOT NULL kèm khoá
// ngoại tới organizations ngay từ đầu — không lặp lại nợ #8 của bốn bảng P1.

enum asset_kind {
  ORIGINAL
  ANALYZED
  ENHANCED
  MASTER
  MARKETING
  CATALOG
  LANDING
  SOCIAL
  VIDEO
  RATIO
}

enum asset_state {
  PROCESSING
  READY
  FAILED
  ARCHIVED
}

enum job_status {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

/**
 * Thu hoạch E1 từ bảng `assets` thật của SocialFlow (23 cột), thêm 11 cột —
 * đặc tả 07 mục 5. Asset gốc bất biến (`YC-A1`); dẫn xuất là bản ghi mới, nối
 * bằng `parent_asset_id` và `version` (`YC-A2` `YC-A3`). `generated_flags`
 * không bao giờ mặc định ngầm (`YC-A5`) — `domain/asset-rules.ts` từ chối tạo
 * asset dẫn xuất thiếu cờ này.
 */
model assets {
  id              String      @id @default(uuid())
  organization_id String
  product_id      String? // null ở workspace trải nghiệm
  parent_asset_id String? // phả hệ; asset gốc có null
  kind            asset_kind
  state           asset_state @default(PROCESSING)
  version         Int         @default(1)

  storage_key  String // org/<organization_id>/<product_id>/<asset_id>.<ext>
  thumb_key    String?
  mime_type    String
  width        Int?
  height       Int?
  aspect_ratio String?
  file_size    Int?

  provider         String?
  model            String?
  model_version    String?
  pipeline_version String?
  parameters       Json?
  prompt           String?

  input_sha256    String?
  output_sha256   String?
  quality_score   Float?
  identity_score  Float?
  generated_flags Json? // { generative_fill_used, requires_reshoot_warning }
  cost_usd        Float?

  // P7 — nợ #30 (TECHNICAL_DEBT.md): cột dựng ở P7 để
  // `GET /integration/products/:id/master-image` lọc đúng theo đặc tả 08 mục
  // 4 ("Chỉ ảnh approval_state = APPROVED"). P7 chỉ ĐỌC cột này — P9 (Identity
  // Guard + Cổng 2 Review & Approve, `media.approve`/`I2`) mới là nơi ĐẶT nó.
  // Trước khi P9 xong, cột luôn PENDING nên endpoint tích hợp luôn trả rỗng —
  // đúng luật "ảnh chờ duyệt không rò ra ngoài core" (đặc tả 08 mục 4), không
  // phải một lỗi.
  approval_state approval_state @default(PENDING)

  // P9 — cổng 2 Review & Approve (`media.approve`/`I2`). M04 mục 5.1 đòi ghi
  // rõ AI ai duyệt và lúc nào trên chính bản ghi ảnh, không chỉ ở audit log:
  // audit log trả lời "chuyện gì đã xảy ra", hai cột này trả lời "ảnh này
  // hiện do ai chịu trách nhiệm" mà không phải quét lịch sử.
  approved_by    String?
  approved_at    DateTime?

  metadata   Json?
  created_by String
  created_at DateTime @default(now())

  organization organizations @relation(fields: [organization_id], references: [id])

  @@index([organization_id])
  @@index([organization_id, product_id])
  @@index([parent_asset_id])
  @@index([output_sha256])
  @@index([organization_id, product_id, kind, approval_state])
}

/**
 * Thu hoạch E2 từ `LocalBudd` (`status` + `step`), thêm trục thứ ba `result`
 * — đặc tả 07 mục 6. Ba trục không gộp (`YC-J1` `YC-J2`).
 *
 * `idempotency_key` không có ở bản đặc tả 07 gốc; thêm ở đây để thực thi
 * `YC-U7` (chống trùng 24 giờ). Lược đồ là nguồn sự thật — tài liệu 07 đã cập
 * nhật theo cùng đợt commit này.
 */
model generation_jobs {
  id              String  @id @default(uuid())
  organization_id String
  workspace_id    String
  branch_id       String?
  user_id         String
  product_id      String?

  feature String // vision.analyze · media.optimize · catalog.generate …
  status  job_status @default(PENDING)
  stage   String? // chỉ có giá trị khi status = PROCESSING
  result  String? // phán quyết nghiệp vụ, độc lập với status

  idempotency_key String? // YC-U7 — duy nhất theo (organization_id, feature)

  // Gom nhiều job cùng một lượt "xuất bộ" của người dùng (vd chạy lô nhiều
  // biến thể M04b, nợ #108) về một màn tiến độ chung — KHÔNG phải khoá
  // nghiệp vụ (mỗi job vẫn có idempotency_key riêng, vẫn trừ credit riêng).
  // NULL cho mọi job không đi qua đường chạy lô, không đổi hành vi cũ.
  job_group_id String?

  payload  Json
  output   Json?
  error    String?
  attempts Int    @default(0)

  created_at   DateTime  @default(now())
  started_at   DateTime?
  completed_at DateTime?
  cancelled_at DateTime?

  organization organizations @relation(fields: [organization_id], references: [id])
  events       job_events[]

  @@unique([organization_id, feature, idempotency_key])
  @@index([organization_id])
  @@index([status, created_at]) // worker quét bằng index này
  @@index([organization_id, user_id])
  @@index([organization_id, job_group_id]) // gom màn tiến độ bộ, nợ #108
}

/**
 * Bảng phụ cho nhật ký tiến trình job — đặc tả 05 mục 8: "một bảng phụ theo
 * job_id với số thứ tự tăng dần, không giữ trong bộ nhớ". Tên bảng và cột
 * không có ở đặc tả 07 gốc; đặt ở đây vì lược đồ là nguồn sự thật. Ghi cộng
 * dồn, không sửa/xoá dòng đã ghi. `seq` tăng dần trong phạm vi một job —
 * client nối tiếp qua `Last-Event-ID` (`YC-J9`).
 */
model job_events {
  id         String   @id @default(uuid())
  job_id     String
  seq        Int
  event      String // stage · log · done
  payload    Json
  created_at DateTime @default(now())

  job generation_jobs @relation(fields: [job_id], references: [id], onDelete: Cascade)

  @@unique([job_id, seq])
  @@index([job_id, seq])
}

/**
 * Một bảng usage duy nhất cho toàn hệ thống (`YC-U1` `YC-U2`) — đặc tả 07 mục
 * 7. Ghi tại điểm tạo job phía core, trong cùng giao dịch với kiểm hạn mức và
 * tạo `generation_jobs` (`YC-U3`). Worker không bao giờ ghi bảng này
 * (`YC-U4`).
 */
model usage {
  id              String  @id @default(uuid())
  organization_id String
  workspace_id    String
  user_id         String
  job_id          String?
  feature         String
  quantity        Int     @default(1)
  cost_credit     Int     @default(0)
  cost_usd        Float? // chi phí thật phía nhà cung cấp, để đối soát
  status          String // ENQUEUED · COMPLETED · REFUNDED
  metadata        Json?
  created_at      DateTime @default(now())

  organization organizations @relation(fields: [organization_id], references: [id])

  @@index([organization_id, created_at])
  @@index([job_id])
}

/**
 * Nhật ký kiểm toán — đặc tả 07 mục 8. Mọi hành động duyệt sinh một bản ghi
 * (`YC-R4`); bảng dựng ở P3 làm hạ tầng dùng chung — endpoint duyệt đầu tiên
 * gọi tới nó bắt đầu từ M01 (`H3`, P5).
 */
model audit_logs {
  id              String   @id @default(uuid())
  organization_id String
  user_id         String
  action          String // product.approve · media.approve · role.manage …
  entity_type     String
  entity_id       String
  before          Json?
  after           Json?
  ip              String?
  user_agent      String?
  created_at      DateTime @default(now())

  organization organizations @relation(fields: [organization_id], references: [id])

  @@index([organization_id, created_at])
  @@index([entity_type, entity_id])
}

// ── Hồ sơ kinh doanh và thương hiệu — P4 ────────────────────────────────────
// Đặc tả 07 mục 4. Thu hoạch E3 từ `SocialFlow/backend/brand_kit.py`
// (`brand_config` gộp cả hai làm một). Core tách đôi: hồ sơ kinh doanh là dữ
// liệu pháp lý và liên hệ (đọc/sửa qua F1/F2, dùng chung cho M05 Landing Page
// và tích hợp ngoài); hồ sơ thương hiệu là dữ liệu tạo sinh (màu, font, tông
// giọng, hashtag, CTA — dùng cho M04b/M05/M07). Mỗi tổ chức đúng một bản ghi
// mỗi bảng (`@@unique([organization_id])`) — nhập một lần, dùng lại xuyên
// module (Checklist P4).

model business_profiles {
  id              String   @id @default(uuid())
  organization_id String
  legal_name      String?
  display_name    String
  phone           String?
  email           String?
  address         String?
  website         String?
  social_links    Json?
  tax_code        String?
  description     String?
  operating_hours Json?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization organizations @relation(fields: [organization_id], references: [id])

  @@unique([organization_id])
}

/**
 * `background_color` và `text_color` có mặt vì `design_contracts` của
 * `LocalBudd` cần đủ bốn màu để dựng landing page — thiếu hai trường này thì
 * M05 phải tự đoán màu nền, và mỗi trang ra một kiểu (đặc tả 07 mục 4).
 * `hashtags`/`cta_templates` là Json vì khác nhau theo nền tảng, đúng hình
 * dạng đã có ở `brand_config.hashtags_<nền tảng>` của SocialFlow.
 */
model brand_profiles {
  id                String   @id @default(uuid())
  organization_id   String
  primary_color     String?
  secondary_color   String?
  accent_color      String?
  background_color  String?
  text_color        String?
  font_heading      String?
  font_body         String?
  logo_asset_id     String?
  tone_of_voice     String?
  hashtags          Json? // mảng thẻ hashtag của cửa hàng — hình dạng thật { default: string[] }, đọc qua extractBrandHashtags() (profile-rules.ts, nợ #103)
  cta_templates     Json? // MỘT câu kêu gọi hành động (nợ #102, chốt 17/09) — hình dạng thật { default: string } do brand-profile-form.tsx ghi, đọc qua extractBrandCtaPhrase() (profile-rules.ts, nợ #103). KHÔNG còn chứa free_gifts/guarantees
  default_offers    Json? // { free_gifts?: string[], guarantees?: string[] } — tách khỏi cta_templates (nợ #102, 17/09):
                          // trước đây `SalesDefaultsForm` ghi nhầm free_gifts/guarantees vào cta_templates, xung đột
                          // với product-copy-adapter.ts coi cta_templates là string[] câu CTA. Đọc có dự phòng dữ
                          // liệu cũ trong cta_templates cho tổ chức đã lưu trước 17/09 — xem sales-defaults-form.tsx.
  forbidden_styles  Json?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  organization organizations @relation(fields: [organization_id], references: [id])

  @@unique([organization_id])
}

// ── P5 — Sản phẩm và phân tích ảnh (M01) ────────────────────────────────────
// Thu hoạch từ đặc tả 07 mục 9. Bốn bảng Product Master + kết quả phân tích.
// Có khoá ngoại `organizations` ngay từ đầu — không lặp lại nợ #8 của P3
// (`TECHNICAL_DEBT.md` #8: bốn bảng thuộc tenant của P3 thiếu khoá ngoại vì
// đặc tả 07 mục 3 khai `organization_id` là cột thường lúc đó).

enum product_status {
  DRAFT
  ACTIVE
  ARCHIVED
}

/** Trạng thái còn hàng của MẪU sản phẩm dựng sẵn tại một chi nhánh (P-Fix-3a, 17/09). */
enum stock_status {
  IN_STOCK
  PRE_ORDER_ONLY
  OUT_OF_STOCK
}

enum approval_state {
  PENDING
  APPROVED
  REJECTED
}

model products {
  id              String         @id @default(uuid())
  organization_id String
  branch_id       String?
  code            String
  name            String
  category        String? // enum identity.category của hợp đồng Vision — Schema.json, không khai lại tay
  shape           String?
  facing          String?
  container       String?
  status          product_status @default(DRAFT)
  attributes      Json?
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  organization organizations @relation(fields: [organization_id], references: [id])
  variants     product_variants[]
  images       product_images[]
  analyses     product_analyses[]
  inventory    product_inventory[]

  @@unique([organization_id, code])
  @@index([organization_id])
}

model product_variants {
  id              String   @id @default(uuid())
  organization_id String
  product_id      String
  name            String
  size            String?
  multiplier      Float    @default(1)
  attributes      Json?

  organization organizations @relation(fields: [organization_id], references: [id])
  product      products      @relation(fields: [product_id], references: [id])

  @@index([organization_id, product_id])
}

model product_images {
  id              String   @id @default(uuid())
  organization_id String
  product_id      String
  asset_id        String
  role            String // MAIN · GALLERY · CATALOG · SOCIAL
  position        Int      @default(0)

  organization organizations @relation(fields: [organization_id], references: [id])
  product      products      @relation(fields: [product_id], references: [id])

  @@unique([organization_id, product_id, asset_id, role])
  @@index([organization_id, product_id])
}

/**
 * Tồn kho MẪU SẢN PHẨM (bó/giỏ dựng sẵn) theo từng chi nhánh — KHÔNG phải tồn kho nguyên
 * liệu hoa rời (chốt với chủ sản phẩm 17/09, xem TECHNICAL_DEBT.md mục P-Fix-3a và
 * `product-master-index.ts`, `ProductMasterIndex.stock`).
 *
 * `branch_id` BẮT BUỘC (không nullable) — mỗi dòng gắn với đúng một chi nhánh cụ thể, tránh
 * hẳn cái bẫy Postgres coi mọi NULL là phân biệt (nợ #7, đã ghi trong TECHNICAL_DEBT.md) mà
 * một `branch_id` tuỳ chọn sẽ vướng phải nếu dùng `@@unique` thông thường.
 */
model product_inventory {
  id                 String      @id @default(uuid())
  organization_id    String
  product_id         String
  branch_id          String
  status             stock_status @default(IN_STOCK)
  quantity_available Int?
  updated_at         DateTime    @updatedAt

  organization organizations @relation(fields: [organization_id], references: [id])
  product      products      @relation(fields: [product_id], references: [id])
  branch       branches      @relation(fields: [branch_id], references: [id])

  @@unique([organization_id, product_id, branch_id])
  @@index([organization_id, branch_id])
}

/**
 * Kết quả phân tích ảnh — `raw` và `edited` tách rời tuyệt đối (đặc tả 07
 * mục 9, `YC-R3`). `raw` là dự đoán gốc của máy theo đúng hợp đồng
 * `PhanTichSanPhamHoa` (`workers/vision/contracts/Schema.json`, R1), không
 * bao giờ bị ghi đè. `edited` là bản người sửa trước khi duyệt (`PATCH
 * /vision/analyses/:id`, `H2`) — dữ liệu huấn luyện tương lai nằm ở cặp
 * *raw/edited* này, không được gộp làm một.
 *
 * `product_id` để trống khi phân tích chưa gắn vào sản phẩm nào (`POST
 * /vision/analyses` cho phép `product_id: null`, đặc tả 06 mục 8) —
 * `approveAnalysis` tạo `products` mới trong trường hợp đó (xem
 * `use-cases/approve-analysis.ts`).
 */
model product_analyses {
  id                String         @id @default(uuid())
  organization_id   String
  product_id        String?
  asset_id          String
  job_id            String

  provider          String
  model             String
  model_version     String
  contract_name     String // "PhanTichSanPhamHoa"
  contract_version  String

  raw               Json // dự đoán gốc của máy, bất biến
  edited            Json? // bản người sửa, lưu tách biệt
  approval_state    approval_state @default(PENDING)
  approved_by       String?
  approved_at       DateTime?

  created_at        DateTime       @default(now())

  organization organizations @relation(fields: [organization_id], references: [id])
  product      products?      @relation(fields: [product_id], references: [id])

  // Một ảnh chỉ có đúng một kết quả trong một lượt job. Không có ràng buộc
  // này thì một job lô hỏng giữa chừng rồi chạy lại (`POST /jobs/:id/retry`)
  // sẽ ghi lần hai cho những ảnh đã phân tích xong ở lần trước — hàng chờ
  // duyệt nhân đôi, và người duyệt không biết bản nào là bản nên duyệt.
  // Worker dựa vào chính ràng buộc này để chạy lại an toàn (`ON CONFLICT`).
  @@unique([job_id, asset_id])
  @@index([organization_id])
  @@index([organization_id, product_id])
  @@index([job_id])
}

/**
 * Bảng dựng cùng đợt vì đặc tả 07 mục 9 khai chung một khối lược đồ với
 * `products`, nhưng **logic giá (M02) thuộc P6, chưa xây ở đây** — bảng này
 * đứng rỗng cho tới khi P6 bắt đầu, đúng luật "core sở hữu entity nhiều
 * module đọc" (kiến trúc V2 mục 2.1), không phải một ngoại lệ nhảy pha.
 */
model pricing_rules {
  id              String   @id @default(uuid())
  organization_id String
  branch_id       String?
  key             String // san · tran · muc_thu · lam_tron …
  value           Json
  effective_from  DateTime @default(now())
  created_by      String

  organization organizations @relation(fields: [organization_id], references: [id])

  @@index([organization_id, key])
}

// ── Integration Layer — P7 ───────────────────────────────────────────────
// Đặc tả 06 mục 11, đặc tả 08. Token máy gọi máy cho `LocalBudd` (M05/M06) và
// `SocialFlow` (M04b/M07) — YC-T8.

enum integration_client {
  LOCALBUDD
  SOCIALFLOW
}

/**
 * Core ký (HMAC, `INTEGRATION_TOKEN_SECRET`) và chỉ giữ `token_hash`, không
 * giữ giá trị token thật — cùng quy ước với `sessions.token_hash`
 * (`session-token.ts`). Phạm vi quyền KHÔNG đi qua 114 mã năng lực của người
 * dùng: nó cố định theo `client` (đặc tả 08 mục 4) và áp thẳng trong từng
 * route `/api/v1/integration/*` — token không phải một vai giao diện, nên
 * không có hàng trong `role_capabilities`/`capability_overrides`.
 *
 * Xoay không dừng dịch vụ (đặc tả 08 mục 3): `rotated_from_id` nối token mới
 * tới token cũ, nhưng tạo token mới KHÔNG tự thu hồi token cũ — core chấp
 * nhận cả hai cùng lúc cho tới khi người quản trị tự thu hồi token cũ qua
 * `DELETE /integration-tokens/:id` (`F9`).
 */
model integration_tokens {
  id              String             @id @default(uuid())
  organization_id String
  client          integration_client
  token_hash      String             @unique
  created_by      String
  created_at      DateTime           @default(now())
  expires_at      DateTime
  revoked_at      DateTime?
  rotated_from_id String?

  organization organizations @relation(fields: [organization_id], references: [id])

  @@index([organization_id])
  @@index([organization_id, client])
}

/// Số liệu hiệu quả nội dung — ghi từ engine ngoài (SocialFlow/LocalBudd) qua Integration API.
/// Idempotent theo khoá tự nhiên: (organization_id, platform, content_id, metric_date).
model content_metrics {
  id              String   @id @default(uuid())
  organization_id String
  platform        String
  content_id      String
  metric_date     DateTime @db.Date

  reach           Int?
  impressions     Int?
  engagement      Int?
  clicks          Int?
  conversions     Int?
  spend_usd       Float?

  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization organizations @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, platform, content_id, metric_date])
  @@index([organization_id])
  @@index([organization_id, metric_date])
}

// ── Nền AI — AI-1 ───────────────────────────────────────────────────────────

/// Sổ đăng ký năng lực. Nội dung nạp từ `src/core/ai/domain/ai-capabilities.ts`
/// (nguồn sự thật của định nghĩa, cùng lối với `capability-catalog.ts`); bảng
/// giữ phần vận hành sửa được: ngưỡng chấp nhận và bật tắt.
model ai_capabilities {
  code             String           @id
  module           String
  kind             String // generative · measuring · deterministic
  needs_approval   Boolean          @default(true)
  privacy_floor    ai_privacy_level @default(SHOP)
  accept_threshold Float? // null = chưa đo được (D20). Cổng AI chấm, ghi, KHÔNG chặn.
  measure_channels Json
  enabled          Boolean          @default(true)
  updated_at       DateTime         @updatedAt

  policies ai_policies[]
}

/// Sổ đăng ký mô hình. Bốn cột giấy phép KHÔNG cho phép rỗng vì lý do pháp lý,
/// không vì lý do kỹ thuật (D18): mô hình thiếu một ô thì không bật được.
model ai_models {
  id             String           @id @default(uuid())
  key            String           @unique
  display_name   String
  provider       String
  mode           ai_mode
  capabilities   Json // mã năng lực nó phục vụ
  license        String
  commercial_use Boolean
  territory      String
  allowed_use    String
  cost_class     String
  latency_class  String
  quality_class  String
  measure_state  ai_measure_state @default(CHUA_DO)
  leaves_infra   Boolean // ảnh có rời hạ tầng không
  enabled        Boolean          @default(false)
  version        String
  registered_by  String?
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt
}

/// Chính sách của tổ chức — TRẦN mà bộ định tuyến được chọn trong đó (D17),
/// không phải một lựa chọn duy nhất.
model ai_policies {
  id              String           @id @default(uuid())
  organization_id String
  capability_code String
  allowed_models  Json // mảng key của ai_models
  quality_target  String?
  cost_ceiling    Int? // credit mỗi lượt
  privacy_floor   ai_privacy_level
  updated_by      String
  updated_at      DateTime         @updatedAt

  organization organizations   @relation(fields: [organization_id], references: [id])
  capability   ai_capabilities @relation(fields: [capability_code], references: [code])

  @@unique([organization_id, capability_code])
  @@index([organization_id])
}

/// Sổ chi phí và chất lượng mỗi LỜI GỌI mô hình. Chỉ ghi thêm. Không giữ
/// prompt lẫn đầu ra — prompt của một lượt sinh nằm ở metadata của asset.
/// Một lượt nghiệp vụ sinh nhiều hàng khi thác nghiệm leo hoặc dự phòng chạy.
model ai_requests {
  id               String   @id @default(uuid())
  organization_id  String
  job_id           String?
  capability_code  String
  model_key        String
  attempt          Int      @default(1)
  escalated_from   String?
  fallback_from    String?
  source           String // CORE · LOCALBUDD · SOCIALFLOW
  input_tokens     Int?
  output_tokens    Int?
  image_count      Int?
  duration_seconds Float?
  gpu_seconds      Float?
  cost_usd         Float? // cùng kiểu với usage.cost_usd
  latency_ms       Int?
  quality_score    Float?
  outcome          String // ACCEPTED · ESCALATED · FAILED · NEEDS_REVIEW
  created_at       DateTime @default(now())

  organization organizations @relation(fields: [organization_id], references: [id])

  @@index([organization_id, created_at])
  @@index([organization_id, capability_code, model_key])
  @@index([job_id])
}

/// Điểm chấm của một đầu ra AI. `needs_review` là cờ đưa bản ghi vào hàng chờ
/// duyệt; nó KHÔNG thay Review → Approve và không thay Identity Guard.
model ai_evaluations {
  id              String   @id @default(uuid())
  organization_id String
  capability_code String
  entity_type     String // product_analysis · product_copy · asset · post …
  entity_id       String
  scores          Json // một khoá cho mỗi kênh đã khai ở ai_capabilities
  overall_score   Float
  threshold_used  Float?
  needs_review    Boolean  @default(false)
  reason          String?
  created_at      DateTime @default(now())

  organization organizations @relation(fields: [organization_id], references: [id])

  @@index([organization_id, entity_type, entity_id])
  @@index([organization_id, capability_code])
}

/**
 * Giọng theo dịp (nợ #104, 18/09) — Tony chốt qua AskUserQuestion 17/09: xây
 * đầy đủ ("làm đầy đủ luôn"), không phải một lát cắt nhỏ trước. Ba giá trị
 * đóng, do TENANT tự gán cho từng dịp qua UI quản lý — hệ thống KHÔNG suy
 * đoán "trang trọng" từ tên dịp bằng từ khoá (đúng nguyên tắc "không bịa" đã
 * áp dụng cho `tone_of_voice`/`cta_templates`, nợ #102/#103).
 */
enum occasion_register {
  FESTIVE
  NEUTRAL
  SOLEMN
}

/// Danh mục dịp — nạp 6 dòng mặc định khi tạo tổ chức (P19, nợ #63).
/// SỬA 18/09 (nợ #104): dòng chú thích cũ ở đây ghi "`dip_su_dung` của
/// product_copies gán theo mã trong bảng này, không phải chuỗi tự do" — đọc
/// thẳng mã thật (sales-pitch-template.ts, product-master-index-repository.ts,
/// mergeOccasions()) cho thấy điều này SAI: `identity.dip_su_dung` luôn là
/// CHUỖI TỰ DO (AI đoán hoặc Sales gõ tay), không có cột nào tham chiếu
/// `occasions.code`. Có thể là định hướng ban đầu chưa từng cài — xoá khẳng
/// định sai thay vì lặp lại nó.
/// Từ nợ #104 (18/09): tenant tự thêm/sửa/tắt dịp qua UI (`OccasionRepository.create/update`),
/// và mỗi dịp mang một `register` để suy ra tông giọng kịch bản Zalo (khớp CHÍNH XÁC
/// theo TÊN dịp với `pitch.occasions[0]`, không phải qua `code`) — xem `occasion-rules.ts`.
model occasions {
  id              String            @id @default(uuid())
  organization_id String
  code            String
  name            String
  sort_order      Int               @default(0)
  is_active       Boolean           @default(true)
  /** Tông giọng khi dịp này được dùng để sinh kịch bản Zalo (nợ #104). */
  register        occasion_register @default(FESTIVE)
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt

  organization organizations @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, code])
  @@index([organization_id])
}

enum template_family {
  GT
  IT
  CT
  ST
  OT
}

/// Ghi đè template theo tenant (nợ #99, Giai đoạn 3 kiến trúc gốc —
/// FLORAOS_TEMPLATE_ENGINE_ARCHITECTURE.md §3, cơ chế kế thừa 2 lớp: System
/// Golden Template -> Tenant Override). BẢNG RIÊNG, không mở rộng
/// `brand_profiles` — quyết định anh Tony 17/09, giữ nguyên sau khi cân nhắc
/// lại 18/09 theo đề xuất kiến trúc: đúng nguyên tắc Atomic Disaggregated
/// Fields (AGENTS.md 1.3), mỗi dòng là MỘT trường ghi đè nguyên tử, tránh lặp
/// lại lỗi hình dạng cột Json không khoá đã gặp ở nợ #102 (`cta_templates`
/// từng mang hai nghĩa xung đột trong cùng một cột, không ai phát hiện kịp).
/// Phạm vi khởi điểm 18/09: domain layer (`template-override-rules.ts`) CHỈ
/// chấp nhận đúng một field đã có nơi đọc thật — (`ST`, `sales_pitch_zalo`,
/// `greeting_line`). Không suy đoán thêm field/template nào khác chưa được
/// xác nhận — mở danh sách trắng đó CÙNG LÚC với khi thêm nơi đọc thật.
model template_overrides {
  id              String          @id @default(uuid())
  organization_id String
  template_family template_family
  template_key    String
  field_key       String
  value           String
  updated_by      String
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt

  organization organizations @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, template_key, field_key])
  @@index([organization_id])
}

/// Liên kết catalog chia sẻ — slug unique toàn cục, thu hồi được, không xoá.
/// LocalBudd đọc qua Integration API để render trang catalog công khai.
model catalog_links {
  id              String   @id @default(uuid())
  organization_id String
  slug            String   @unique
  name            String
  description     String?
  filters         Json?
  is_revoked      Boolean  @default(false)
  revoked_at      DateTime?
  revoked_by      String?
  created_by      String
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization organizations @relation(fields: [organization_id], references: [id])

  @@index([organization_id])
  @@index([slug])
}

// ── M01b — Product Sales Data (Tên, Mô tả, Thẻ, Phân khúc giá) ────────────────
// P14: Dữ liệu bán hàng sinh từ lượt phân tích đã duyệt. `raw`/`edited` tách rời
// (YC-R3). `analysis_id` trỏ tới `product_analyses` đã APPROVED.
// Duyệt (`H6`) ghi Product Master + `audit_logs` trong một giao dịch.
model product_copies {
  id              String   @id @default(uuid())
  organization_id String
  analysis_id     String // bắt buộc: product_analyses đã APPROVED
  product_id      String? // null khi phân tích chưa gắn sản phẩm (sẽ tạo mới khi duyệt)

  // Dự đoán gốc của máy (bất biến) — keys: suggested_name, suggested_description,
  // suggested_tags[], suggested_occasions[], suggested_price_segment
  raw             Json
  // Bản người sửa trước khi duyệt (PATCH /product-copies/:id, H5)
  edited          Json?
  approval_state  approval_state @default(PENDING)
  approved_by     String?
  approved_at     DateTime?

  // Phiên bản hồ sơ phong cách đã dùng (learning_profiles.version), để truy xuất
  profile_version String?

  // Lý do từ chối — CỘT RIÊNG, không nhét vào `edited`. `edited` là bản sửa
  // của người theo hình dạng câu chữ bán hàng; trộn một khoá quản trị vào đó
  // làm `resolveEffective` phải phân biệt hai loại khoá trong cùng một object.
  reject_reason   String?

  // Truy vết lượt gọi mô hình đã sinh ra bản này — PRD mục 9, nhóm "Truy vết".
  // Không có bốn cột này thì không đối soát được chi phí, không so sánh được
  // hai mô hình, và không biết bản nào sinh ra bởi mô hình nào khi đổi mô hình.
  job_id          String?
  model_key       String?
  provider        String?
  cost_usd        Float?
  latency_ms      Int?

  created_at      DateTime @default(now())

  organization organizations @relation(fields: [organization_id], references: [id])

  @@unique([analysis_id]) // một lượt phân tích chỉ tạo một product_copy
  @@index([organization_id])
  @@index([organization_id, product_id])
  @@index([approval_state])
}

// ── M04c — AI Video Studio (Reel, TikTok, Story, Slideshow) ─────────────────

enum video_format {
  REEL_15S
  TIKTOK_30S
  STORY_15S
  SLIDESHOW
  PRODUCT_PAGE
  AD_MOTION
}

enum video_stage {
  DRAFT
  SCRIPT_GENERATING
  SCRIPT_READY
  SCRIPT_APPROVED
  RENDERING
  RENDER_COMPLETED
  APPROVED
  REJECTED
  FAILED
}

model video_jobs {
  id                 String          @id @default(uuid())
  organization_id    String
  product_id         String?
  title              String
  format             video_format
  stage              video_stage     @default(DRAFT)

  // Cổng duyệt 1: Kịch bản (Script / Storyboard)
  script_approval    approval_state  @default(PENDING)
  script_approved_at DateTime?
  script_approved_by String?

  // Cổng duyệt 2: Video kết quả (Final Render)
  video_approval     approval_state  @default(PENDING)
  video_approved_at  DateTime?
  video_approved_by  String?

  // Cấu hình video
  duration_seconds   Int             @default(15)
  aspect_ratio       String          @default("9:16")
  music_track        String?
  voice_code         String?
  has_subtitle       Boolean         @default(true)
  caption_style      String          @default("MODERN_BADGE")
  has_watermark      Boolean         @default(false)

  // Đợt 4 (24/09/2026): video lắp từ KỊCH BẢN SẢN XUẤT TỔNG + bản phối Khu vực C.
  // Có `audio_storage_key` thì worker dùng nguyên bản phối, không đọc lại TTS.
  scene_plan_id       String?
  scene_plan_revision Int?
  audio_job_id        String?
  audio_storage_key   String?

  // Tài sản đầu ra & Hạch toán
  final_video_url    String?
  final_asset_id     String?
  cost_credits       Int             @default(0)
  error_message      String?

  created_at         DateTime        @default(now())
  updated_at         DateTime        @updatedAt

  organization       organizations   @relation(fields: [organization_id], references: [id])
  scenes             video_scenes[]

  @@index([organization_id])
  @@index([organization_id, product_id])
  @@index([stage])
  @@index([script_approval])
  @@index([video_approval])
}

model video_scenes {
  id                String       @id @default(uuid())
  video_job_id      String
  scene_index       Int
  duration_seconds  Float        @default(3.0)
  image_asset_id    String?
  text_overlay      String?
  voice_script      String?
  transition_effect String?      @default("fade")
  /// Ken Burns (ZOOM_IN | ZOOM_OUT | PAN_UP | PAN_RIGHT | STATIC) — 23/09/2026:
  /// trước đó lựa chọn ở Khu vực E không được lưu, worker luôn tự xoay vòng.
  motion_effect     String?
  created_at        DateTime     @default(now())

  job               video_jobs   @relation(fields: [video_job_id], references: [id], onDelete: Cascade)

  @@index([video_job_id])
  @@unique([video_job_id, scene_index])
}

// ── M10 — Đơn hàng và vận hành (P22) ────────────────────────────────────────

enum order_status {
  DRAFT
  CONFIRMED
  PROCESSING
  DELIVERED
  COMPLETED
  CANCELLED
}

enum production_status {
  WAITING
  ASSIGNED
  ARRANGING
  QUALITY_CHECK
  READY
}

enum delivery_status {
  PENDING
  DISPATCHED
  DELIVERING
  DELIVERED
  FAILED
}

model orders {
  id                String            @id @default(uuid())
  organization_id   String
  branch_id         String?
  code              String
  customer_id       String?
  status            order_status      @default(DRAFT)
  production_status production_status @default(WAITING)
  delivery_status   delivery_status   @default(PENDING)

  total_vnd         Decimal           @db.Decimal(14, 2)
  pricing_rule_ref  Json?                       // quy tắc giá đã dùng, để đối soát
  voucher_id        String?
  card_message      String?                     // lời nhắn thiệp, tách khỏi ghi chú nội bộ
  internal_note     String?
  delivery_window   Json?                       // ngày và khung giờ đã hẹn
  delivery_address  Json?

  created_by        String
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt

  organization      organizations     @relation(fields: [organization_id], references: [id])
  customer          customers?        @relation(fields: [customer_id], references: [id])
  items             order_items[]
  assignments       order_assignments[]
  events            order_events[]
  coordination      order_coordinations?
  qc_records        order_qc_records[]
  exceptions        order_exceptions[]

  @@unique([organization_id, code])
  @@index([organization_id, status])
  @@index([organization_id, production_status])
}

model order_items {
  id              String   @id @default(uuid())
  organization_id String
  order_id        String
  product_id      String?
  variant_id      String?
  description     String?              // khi khách đặt mẫu ngoài danh mục
  quantity        Int      @default(1)
  unit_price_vnd  Decimal  @db.Decimal(14, 2)
  metadata        Json?                // BOM có cấu trúc (FlowerBomItem[]), wrapStyle/ribbon, ảnh mẫu — từ Product Master Index lúc chọn mẫu, để phiếu cắm hoa (florist ticket) không phải bịa dữ liệu

  organization    organizations @relation(fields: [organization_id], references: [id])
  order           orders        @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([organization_id, order_id])
}

model order_assignments {
  id              String   @id @default(uuid())
  organization_id String
  order_id        String
  assignee_id     String                // thành viên nhận việc cắm
  assigned_by     String
  difficulty      String?               // định mức tiền công theo độ khó
  assigned_at     DateTime @default(now())
  released_at     DateTime?

  organization    organizations @relation(fields: [organization_id], references: [id])
  order           orders        @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([organization_id, assignee_id])
  @@index([organization_id, order_id])
}

model order_events {
  id              String   @id @default(uuid())
  organization_id String
  order_id        String
  axis            String                // order · production · delivery
  from_value      String?
  to_value        String
  actor_id        String?
  reason          String?
  created_at      DateTime @default(now())

  organization    organizations @relation(fields: [organization_id], references: [id])
  order           orders        @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([organization_id, order_id, created_at])
}

// ── M09 — CRM & Khách hàng ngành hoa (P21) ──────────────────────────────────

enum customer_tier {
  NEW
  BRONZE
  SILVER
  GOLD
  VIP
}

enum consent_channel {
  ZALO_ZNS
  SMS
  PHONE_CALL
  PROMOTION
}

enum voucher_discount_type {
  PERCENTAGE
  FIXED_AMOUNT
}

model customers {
  id                String         @id @default(uuid())
  organization_id   String
  code              String         // KH-0001, KH-0002
  name              String
  phone             String
  email             String?
  address           String?
  tier              customer_tier  @default(NEW)
  notes             String?
  tags              String[]       @default([])
  preferred_flowers String[]       @default([])
  preferred_colors  String[]       @default([])

  total_spent       Decimal        @default(0) @db.Decimal(14, 2)
  order_count       Int            @default(0)
  last_order_at     DateTime?

  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt

  organization      organizations  @relation(fields: [organization_id], references: [id])
  orders            orders[]
  occasions         customer_occasions[]
  consents          customer_consents[]
  vouchers          vouchers[]
  conversations     chat_conversations[]

  @@unique([organization_id, phone])
  @@unique([organization_id, code])
  @@index([organization_id, tier])
  @@index([organization_id, name])
}

model customer_occasions {
  id                   String        @id @default(uuid())
  organization_id      String
  customer_id          String
  name                 String        // Sinh nhật vợ, Kỷ niệm ngày cưới, Ngày của Mẹ...
  date                 String        // MM-DD hoặc YYYY-MM-DD
  is_recurring         Boolean       @default(true)
  reminder_days_before Int           @default(7)
  recipient_name       String?
  notes                String?
  created_at           DateTime      @default(now())

  organization         organizations @relation(fields: [organization_id], references: [id])
  customer             customers     @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([organization_id, customer_id])
  @@index([organization_id, date])
}

model customer_consents {
  id              String          @id @default(uuid())
  organization_id String
  customer_id     String
  channel         consent_channel
  granted         Boolean         @default(true)
  granted_at      DateTime        @default(now())
  revoked_at      DateTime?
  created_at      DateTime        @default(now())

  organization    organizations   @relation(fields: [organization_id], references: [id])
  customer        customers       @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@unique([customer_id, channel])
  @@index([organization_id, customer_id])
}

model vouchers {
  id               String                @id @default(uuid())
  organization_id  String
  customer_id      String?               // null nếu áp dụng công khai
  code             String                // FLORA10, VIP2026
  discount_type    voucher_discount_type @default(PERCENTAGE)
  discount_value   Decimal               @db.Decimal(14, 2)
  min_order_vnd    Decimal               @default(0) @db.Decimal(14, 2)
  max_discount_vnd Decimal?              @db.Decimal(14, 2)
  expires_at       DateTime?
  is_used          Boolean               @default(false)
  used_at          DateTime?
  order_id         String?
  created_at       DateTime              @default(now())

  organization     organizations         @relation(fields: [organization_id], references: [id])
  customer         customers?            @relation(fields: [customer_id], references: [id])

  @@unique([organization_id, code])
  @@index([organization_id, customer_id])
}

// ── M08 — AI Chat Assistant & Hội thoại (P23) ──────────────────────────────

enum chat_channel {
  WEB_WIDGET
  INTERNAL_DASHBOARD
  STOREFRONT_CATALOG
  LANDING_PAGE
  FACEBOOK_MESSENGER
  ZALO_OA
  EMBEDDED_WIDGET
  ZALO
}

enum chat_sender_type {
  USER
  ASSISTANT
  SYSTEM
}

model chat_conversations {
  id              String        @id @default(uuid())
  organization_id String
  customer_id     String?
  title           String        @default("Hội thoại tư vấn hoa")
  channel         chat_channel  @default(WEB_WIDGET)
  status          String        @default("ACTIVE") // ACTIVE, CLOSED
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  organization    organizations @relation(fields: [organization_id], references: [id])
  customer        customers?    @relation(fields: [customer_id], references: [id])
  messages        chat_messages[]

  @@index([organization_id, status])
  @@index([organization_id, customer_id])
}

model chat_messages {
  id              String            @id @default(uuid())
  organization_id String
  conversation_id String
  sender_type     chat_sender_type
  content         String
  metadata        Json?             // Gợi ý hoa từ Master Index, Draft Order ID

  created_at      DateTime          @default(now())

  organization    organizations      @relation(fields: [organization_id], references: [id])
  conversation    chat_conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([organization_id, conversation_id, created_at])
}

model chat_channel_integrations {
  id                       String        @id @default(uuid())
  organization_id          String
  channel                  chat_channel
  is_enabled               Boolean       @default(false)
  config                   Json          @default("{}")
  subscription_expires_at  DateTime?
  created_at               DateTime      @default(now())
  updated_at               DateTime      @updatedAt

  organization             organizations @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, channel])
  @@index([organization_id, is_enabled])
}

// ── Danh mục loài hoa ───────────────────────────────────────────────────────
// NGOẠI LỆ DUY NHẤT của Luật 1 (mọi bảng thuộc tenant mang organization_id):
// đây là tri thức ngành, không phải dữ liệu của một cửa hàng. Hồng vẫn là
// hồng ở mọi tổ chức. Đặt `organization_id` vào đây sẽ buộc mỗi tổ chức mới
// phải chép lại 86 loài, và hai tổ chức sẽ dần gọi cùng một loài bằng hai mã.
//
// Nguồn: `workers/vision/contracts/species_catalog.json`, trích từ sổ vận
// hành thật của AVI GIFT. Từ tệp JSON đọc-một-chiều thành bảng: cần thế để
// người vận hành sửa được tên và dấu hiệu phân biệt mà không phải sửa mã, và
// để bước soát tên loài tra được bằng truy vấn thay vì nạp cả tệp vào bộ nhớ.

model flower_taxonomy {
  ma_loai      String  @id // LH001…
  nhom         String  // Hoa · Lá · Phụ kiện
  cong_nang    String? // Hoa chính · Hoa phụ · Hoa lấp đầy…
  ten_chuan    String
  ten_khac     Json    // string[] — tên gọi khác, dùng để so tên máy trả về
  nhom_hoa     String?
  dvt_chuan    String?
  so_bong_tren_dvt Int?
  duong_kinh_bong_cm Float?
  dien_tich_phu_cm2  Float?
  ty_le_nhuy_tren_bong Float?
  mau_nhuy     String?
  kieu_moc     String?
  dai_mau_tu_nhien Json?  // string[]
  dac_diem_phan_biet String?
  mua_vu       String?
  trang_thai   String  @default("Đang dùng")

  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  cap_a flower_confusable_pairs[] @relation("loai_a")
  cap_b flower_confusable_pairs[] @relation("loai_b")

  @@index([ten_chuan])
  @@index([nhom])
}

// 63 cặp dễ nhầm. Đây là chỗ bắt LỖI HỆ THỐNG của bước nhận diện — dạng lỗi
// mà gọi lại mô hình ba lượt vẫn ra cùng một câu trả lời sai, nên cơ chế
// đồng thuận không thấy. Máy trả về một loài nằm trong một cặp `Cao` thì
// giao diện phải bày dấu hiệu tách của cả hai cho người soát nhìn, chứ không
// im lặng nhận lấy tên máy đưa.
model flower_confusable_pairs {
  ma_cap          String @id // CN001…
  ma_loai_a       String
  ma_loai_b       String
  dau_hieu_tach_a String
  dau_hieu_tach_b String
  muc_do_nham     String // Cao · Trung bình · Thấp

  loai_a flower_taxonomy @relation("loai_a", fields: [ma_loai_a], references: [ma_loai])
  loai_b flower_taxonomy @relation("loai_b", fields: [ma_loai_b], references: [ma_loai])

  @@index([ma_loai_a])
  @@index([ma_loai_b])
  @@index([muc_do_nham])
}

// ─────────────────────────────────────────────────────────────────────────
// Console Vận hành Nền tảng (P25, chốt 18-19/09/2026) — ba bảng KHÔNG mang
// `organization_id`, ngoại lệ có chủ đích của Luật 1 (đặc tả 07 mục 1),
// cùng hạng với `ai_capabilities`/`ai_models`. Xem
// docs/kien-truc/KE_HOACH_CONSOLE_VAN_HANH.md mục 4.1 và D-N6 (tách hẳn từ
// vựng năng lực nền tảng khỏi `roles`/`role_capabilities` của tenant —
// KHÔNG dùng `capability_scope`, không thêm giá trị PLATFORM vào enum đó).
// `tests/helpers/database.ts` KHÔNG truncate ba bảng này, giống ai_models.

/// Người được cấp quyền vận hành nền tảng — độc lập hoàn toàn với
/// `memberships`. Một user có thể vừa là thành viên một tổ chức (qua
/// memberships) vừa là người vận hành nền tảng (qua bảng này) — hai bảng
/// không loại trừ nhau. Gán lần đầu bằng script chạy tay
/// `scripts/gan-van-hanh-nen-tang.ts` (D-N2) — không có UI tự gán.
model platform_operators {
  id         String    @id @default(uuid())
  user_id    String    @unique
  granted_by String? // user_id của người gán, null nếu tự gán qua script lần đầu
  created_at DateTime  @default(now())
  revoked_at DateTime?

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  capabilities platform_role_capabilities[]

  @@index([user_id])
}

/// Mã năng lực nền tảng (`N1`…`N8`, `src/core/platform/platform-capability-catalog.ts`)
/// cấp cho một người vận hành. TÁCH HẲN khỏi `role_capabilities` của
/// tenant (D-N6) — không có "vai" ở đây, mỗi người vận hành có tập mã
/// riêng, gán thẳng.
model platform_role_capabilities {
  id              String @id @default(uuid())
  operator_id     String
  capability_code String // N1 … N8

  operator platform_operators @relation(fields: [operator_id], references: [id], onDelete: Cascade)

  @@unique([operator_id, capability_code])
}

/// Nhật ký cho hành động KHÔNG thuộc một tổ chức cụ thể (xem sức khoẻ hệ
/// thống, gán/thu vai vận hành). Hành động chạm MỘT tổ chức cụ thể (nạp
/// credit, duyệt nâng cấp) vẫn ghi vào `audit_logs` hiện có với
/// `organization_id` của tổ chức đó — bảng này không thay thế `audit_logs`.
/// Tách riêng vì `audit_logs.organization_id` là `NOT NULL` (D-N3).
model platform_audit_logs {
  id          String   @id @default(uuid())
  user_id     String
  action      String // platform.health.read · platform.operator.grant …
  entity_type String
  entity_id   String
  before      Json?
  after       Json?
  ip          String?
  user_agent  String?
  created_at  DateTime @default(now())

  @@index([created_at])
  @@index([entity_type, entity_id])
}

// ─────────────────────────────────────────────────────────────────────────
// Phân hệ Nghiên cứu Thị trường & Xu hướng (Market Intelligence Engine) — Đợt A
// 8 bảng nghiên cứu dữ liệu thị trường là GLOBAL (ngoại lệ Luật 1 khai báo ở
// đặc tả 07 mục 1 & 16), 1 bảng content_opportunities thuộc TENANT.

enum market_source_status {
  ACTIVE
  DEGRADED
  DISABLED
}

enum trend_topic_status {
  EMERGING
  RISING
  STABLE
  DECLINING
  SEASONAL
  BREAKOUT
}

enum research_run_type {
  DAILY_DEEP
  INTRADAY_PULSE
  WEEKLY_DEEP
  MANUAL
}

enum research_run_status {
  PENDING
  RUNNING
  PARTIAL_SUCCESS
  COMPLETED
  FAILED
}

enum provider_health_status {
  HEALTHY
  DEGRADED
  UNAVAILABLE
}

/// Nguồn thu thập dữ liệu xu hướng thị trường (Google Trends, SerpApi, v.v.)
model market_sources {
  id              String               @id @default(uuid())
  provider        String
  platform        String
  source_type     String
  status          market_source_status @default(ACTIVE)
  last_success_at DateTime?
  last_error_at   DateTime?
  created_at      DateTime             @default(now())
  updated_at      DateTime             @updatedAt

  trend_signals trend_signals[]
  topic_signals topic_signals[]

  @@unique([provider, platform])
}

/// Tín hiệu xu hướng thu thập được từ các nguồn
model trend_signals {
  id           String   @id @default(uuid())
  source_id    String
  platform     String
  country_code String   @default("VN")
  region_code  String?
  city         String?
  industry     String   @default("florist")
  topic_raw    String
  metric_name  String
  metric_value Float
  growth_rate  Float?
  confidence   Float    @default(1.0)
  captured_at  DateTime @default(now())
  created_at   DateTime @default(now())

  source market_sources @relation(fields: [source_id], references: [id], onDelete: Cascade)

  @@unique([source_id, platform, country_code, topic_raw, captured_at])
  @@index([source_id])
  @@index([platform, country_code])
  @@index([captured_at])
  @@index([industry])
}

/// Chuỗi thời gian của chủ đề xu hướng
model trend_timeseries {
  id           String   @id @default(uuid())
  topic_id     String
  platform     String
  geo_scope    String   @default("VN")
  date         DateTime
  value        Float
  growth_rate  Float?
  velocity     Float?
  acceleration Float?
  confidence   Float    @default(1.0)

  topic topics @relation(fields: [topic_id], references: [id], onDelete: Cascade)

  @@unique([topic_id, platform, geo_scope, date])
  @@index([topic_id])
  @@index([date])
}

/// Chủ đề xu hướng được chuẩn hóa (canonical topics)
model topics {
  id             String             @id @default(uuid())
  canonical_name String
  description    String?
  language       String             @default("vi")
  industry       String             @default("florist")
  status         trend_topic_status @default(EMERGING)
  first_seen_at  DateTime           @default(now())
  last_seen_at   DateTime           @default(now())

  timeseries            trend_timeseries[]
  signals               topic_signals[]
  scores                topic_scores[]
  content_opportunities content_opportunities[]

  @@unique([canonical_name, industry])
  @@index([status])
  @@index([industry])
  @@index([last_seen_at])
}

/// Nối giữa chủ đề và nguồn tín hiệu gốc
model topic_signals {
  id                 String   @id @default(uuid())
  topic_id           String
  source_id          String
  external_reference String?
  signal_type        String
  signal_value       Float
  captured_at        DateTime @default(now())

  topic  topics         @relation(fields: [topic_id], references: [id], onDelete: Cascade)
  source market_sources @relation(fields: [source_id], references: [id], onDelete: Cascade)

  @@index([topic_id])
  @@index([source_id])
}

/// Điểm số tổng hợp của chủ đề xu hướng
model topic_scores {
  id                        String   @id @default(uuid())
  topic_id                  String
  geo_scope                 String   @default("VN")
  industry                  String   @default("florist")
  period                    String   @default("7d")
  trend_score               Float
  viral_score               Float
  commercial_score          Float
  content_opportunity_score Float
  confidence                Float    @default(1.0)
  calculated_at             DateTime @default(now())
  model_version             String   @default("v1_florist")

  topic topics @relation(fields: [topic_id], references: [id], onDelete: Cascade)

  @@index([topic_id])
  @@index([period])
  @@index([content_opportunity_score])
}

/// Gợi ý cơ hội nội dung được cá nhân hóa cho từng tổ chức (TENANT)
model content_opportunities {
  id                        String   @id @default(uuid())
  organization_id           String
  topic_id                  String
  audience                  String?
  opportunity_summary       String
  content_angles            Json
  recommended_formats       Json
  recommended_hooks         Json
  trend_score               Float
  viral_score               Float
  commercial_score          Float
  content_opportunity_score Float
  confidence                Float    @default(1.0)
  expires_at                DateTime?
  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt

  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  topic        topics        @relation(fields: [topic_id], references: [id], onDelete: Cascade)

  @@index([organization_id, content_opportunity_score])
  @@index([organization_id])
  @@index([topic_id])
}

/// Lưu lại từng lượt phân tích Product Intelligence (Quét theo ảnh sản phẩm) — TENANT.
/// Nợ kỹ thuật #113 (đã trả 21/09/2026): trước đây route chạy xong là mất, không có lịch sử.
/// `report` lưu nguyên vẹn toàn bộ ProductIntelligenceReport dạng JSONB (đúng khuyến nghị
/// "Use JSONB for flexible AI output" ở mục 35 đặc tả v2.0) — các trường điểm số tách cột
/// riêng để lọc/sắp xếp nhanh mà không phải parse JSON.
///
/// Nợ #118 (chốt 22/09/2026, trả cùng lượt sửa Chặng 05 CHOOSE gãy):
/// `asset_id` chuyển BẮT BUỘC (trước đó `String?`) — không còn nhận lượt
/// phân tích nào không neo vào một asset thật. `image_url` BỎ HẲN cột này —
/// nó từng lưu thẳng Data URL base64 của client (770KB–1MB/dòng, xác minh
/// trên Postgres dev thật 22/09/2026), trùng lặp với chính asset đã có ở
/// bảng `assets`. Ảnh hiển thị từ nay LUÔN ký lại tại thời điểm đọc qua
/// `GET /api/v1/assets/:id/view-url`, không lưu URL/base64 ở bất kỳ đâu.
/// `report` JSONB cũng không còn mang `imageUrl` thật (rỗng hoá trước khi
/// ghi) — xem `analyze-product-intelligence.ts`.
model product_analysis_runs {
  id                  String   @id @default(uuid())
  organization_id     String
  asset_id            String
  product_name        String
  trend_fit_score     Float
  audience_fit_score  Float
  content_fit_score   Float
  overall_fit         String
  report              Json
  created_at          DateTime @default(now())

  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id, created_at])
}

/// Lượt chạy nghiên cứu thị trường — kiêm hàng đợi job cho worker
model research_runs {
  id                    String              @id @default(uuid())
  run_type              research_run_type   @default(DAILY_DEEP)
  status                research_run_status @default(PENDING)
  started_at            DateTime?
  completed_at          DateTime?
  sources_attempted     Int                 @default(0)
  sources_succeeded     Int                 @default(0)
  sources_failed        Int                 @default(0)
  records_collected     Int                 @default(0)
  topics_created        Int                 @default(0)
  opportunities_created Int                 @default(0)
  error_summary         String?
  created_at            DateTime            @default(now())

  @@index([status, created_at])
}

/// Bảng theo dõi sức khỏe và chất lượng của các nhà cung cấp dữ liệu xu hướng
model provider_health {
  id              String                 @id @default(uuid())
  provider        String                 @unique
  status          provider_health_status @default(HEALTHY)
  latency_ms      Int?
  error_rate      Float?
  quota_status    String?
  last_checked_at DateTime               @default(now())

  @@index([status])
}

/// Gói chiến dịch của Creative Studio (Khu vực F, Chặng 07–14) — TENANT.
/// 23/09/2026: trước ngày này Chặng 07–09 chỉ là state phía trình duyệt (QA
/// luôn "PASSED", duyệt không ghi gì) và Chặng 10–14 hiển thị số liệu gõ cứng.
/// Gói chỉ giữ ĐỊNH DANH tới tài sản thật (asset biến thể, video job, audio job)
/// + nội dung bài đăng do người dùng soạn; QA chạy phía máy chủ trên dữ liệu thật
/// (`campaign-package-rules.ts`), duyệt ghi `audit_logs` cùng giao dịch.
model campaign_packages {
  id                 String    @id @default(uuid())
  organization_id    String
  product_id         String?
  master_asset_id    String
  name               String
  mode               String                      // CREATIVE | AUTHENTIC
  /// Ảnh chụp chủ đề đã chọn ở Chặng 05 (id, title, angleCategory, hook, cta).
  topic              Json?
  /// Nội dung bài đăng theo kênh: [{ channel, text, hashtags[] }].
  content            Json?
  variant_asset_ids  String[]  @default([])
  /// Video chính (= phần tử đầu của `video_job_ids`, giữ để tương thích).
  video_job_id       String?
  /// Mọi video của gói — mỗi khung hình trong phạm vi sản xuất một video (24/09/2026).
  video_job_ids      String[]  @default([])
  audio_job_id       String?
  /// DRAFT | QA_PASSED | QA_NEEDS_REVIEW | QA_REJECTED | APPROVED
  status             String    @default("DRAFT")
  qa_report          Json?
  qa_checked_at      DateTime?
  approved_by        String?
  approved_at        DateTime?
  /// Kế hoạch đăng (Chặng 10): { channels[], scheduled_at, post_refs[{platform, content_id}] }.
  launch_plan        Json?
  created_by         String
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id, created_at])
  @@index([organization_id, master_asset_id])
  @@index([organization_id, status])
}

/// Bài đăng Khu vực B (Chặng 06a) TỰ LƯU theo ảnh + chủ đề + mode (24/09/2026) —
/// để Chặng 07 đưa sẵn vào gói chiến dịch mà người dùng không phải bấm lưu.
/// TENANT: `organization_id` bắt buộc, mọi truy vấn qua `scopedWhere`/`scopedData`.
model content_drafts {
  id              String   @id @default(uuid())
  organization_id String
  /// Ảnh sản phẩm Khu vực A (`assets.id`) — cùng khoá với kịch bản bối cảnh.
  asset_id        String
  topic_id        String
  mode            String                        // CREATIVE | AUTHENTIC
  topic_title     String?
  /// [{ channel, text, hashtags[] }] — cùng hình dạng `campaign_packages.content`.
  posts           Json
  created_by      String
  updated_by      String
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, asset_id, topic_id, mode])
  @@index([organization_id, updated_at])
}

/// Kết quả Content Engine (P27, quyết định PO 25/09/2026). TENANT. Một bản ghi
/// mỗi lượt viết bài của chuỗi agent Strategist→Writer→Critic→Rewriter (Đợt 2)
/// — brief chụp sẵn tại thời điểm chạy, phiên bản prompt/rubric, bài theo từng
/// kênh kèm điểm, để tái hiện/so sánh và nâng cấp đo được (mục 5 kế hoạch).
model content_generations {
  id              String  @id @default(uuid())
  organization_id String
  job_id          String?
  /// creative_studio | content_engine_ui | package_rewrite
  origin          String
  asset_id        String?
  product_id      String?
  topic_id        String?
  scene_plan_id   String?
  /// AUTHENTIC | CREATIVE — vắng khi không gắn với kịch bản Chặng 05
  mode            String?

  /// Kênh đã chạy — facebook | instagram | tiktok | zalo
  channels Json
  /// Bản chụp Content Brief v1 tại thời điểm chạy (`contracts/brief.ts`).
  brief    Json
  /// Trùng `contracts/brief.ts#BRIEF_VERSION` tại thời điểm chạy.
  brief_version Int
  /// { strategist, writer, critic, rewriter } — mã phiên bản prompt mỗi bước.
  prompt_versions Json
  rubric_version  String

  /// Kết quả Strategist — thông điệp chính + góc/hook/dàn ý mỗi kênh.
  strategy Json?
  /// [{ channel, text, hashtags, fact_ids, scores, rounds, needs_review, source }]
  posts         Json
  overall_score Float?
  /// Bài sau khi chủ tiệm sửa rồi duyệt — nguồn học phong cách tiệm (Đợt 4).
  approved_posts Json?

  /// DRAFT | APPROVED | SCHEDULED
  status          String  @default("DRAFT")
  /// Mã bài bên SocialFlow sau khi gửi Lịch đăng (Đợt 3).
  social_post_ids Json?
  created_by      String
  approved_by     String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id, asset_id, topic_id, mode])
  @@index([organization_id, created_at])
}

/// Giọng nhân bản của chủ tiệm (Khu vực C — Voice Clone, 24/09/2026). TENANT.
/// Mẫu giọng lưu ở kho (`sample_storage_key`); worker `audio.voice_clone` gửi
/// mẫu lên ElevenLabs Instant Voice Clone và ghi `provider_voice_id`.
model voice_clones {
  id                 String    @id @default(uuid())
  organization_id    String
  name               String
  provider           String    @default("elevenlabs")
  provider_voice_id  String?
  /// PENDING | READY | FAILED | DELETED
  status             String    @default("PENDING")
  sample_storage_key String
  sample_mime_type   String
  sample_bytes       Int
  /// Câu cam kết người dùng đã tick (lưu nguyên văn để đối soát).
  consent_text       String
  consented_by       String
  consented_at       DateTime
  job_id             String?
  error              String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  deleted_at         DateTime?

  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id, status])
}

/// Nhạc nền do tiệm tự tải (Khu vực C — Music Select, 24/09/2026). TENANT.
/// Thư viện hệ thống nằm ở `music-catalog.ts` (có trường giấy phép), không ở bảng này.
model music_tracks {
  id               String    @id @default(uuid())
  organization_id  String
  title            String
  /// romantic | upbeat | chill | warm | luxury
  mood             String
  storage_key      String
  mime_type        String
  file_bytes       Int
  duration_seconds Float?
  /// owned | royalty_free | licensed | creative_commons
  license_type     String
  /// Nơi mua / đường dẫn giấy phép / tác giả — bắt buộc.
  license_source   String
  license_note     String?
  attested_by      String
  attested_at      DateTime
  created_at       DateTime  @default(now())
  deleted_at       DateTime?

  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id, mood])
}

// ── Chức năng 12: Điều phối Đơn hàng & Control Tower ─────────────────────────

enum coordinator_stage {
  INTAKE
  VALIDATING
  PLANNING
  ASSIGNING
  IN_PRODUCTION
  QUALITY_CHECK
  DISPATCHING
  DELIVERED
  COMPLETED
  EXCEPTION
  CANCELLED
}

enum coordination_risk_level {
  NORMAL
  ATTENTION
  AT_RISK
  CRITICAL
}

enum qc_record_status {
  PENDING
  PASSED
  REJECTED
  REWORK_REQUESTED
}

/// Mạng lưới đối tác xưởng ngoài / thợ cắm hoa. TENANT ISOLATION.
model partners {
  id              String   @id @default(uuid())
  organization_id String
  code            String
  name            String
  phone           String
  address         String?
  district        String?
  province        String?
  tier            String   @default("STANDARD")
  rating          Decimal  @default(5.0) @db.Decimal(3, 2)
  capacity_daily  Int      @default(10)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization    organizations         @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  coordinations   order_coordinations[]

  @@unique([organization_id, code])
  @@index([organization_id, is_active])
}

/// Hồ sơ điều phối tiến trình của từng đơn hàng. TENANT ISOLATION.
model order_coordinations {
  id                    String                  @id @default(uuid())
  organization_id       String
  order_id              String                  @unique
  partner_id            String?
  coordinator_id        String?
  stage                 coordinator_stage       @default(INTAKE)
  risk_level            coordination_risk_level @default(NORMAL)
  risk_reason           String?
  next_action           String?
  next_action_due       DateTime?
  estimated_delivery_at DateTime?
  actual_delivery_at    DateTime?
  /// Bước quay về khi mọi sự cố của đơn đã xử lý xong (stage = EXCEPTION).
  resume_stage          coordinator_stage?
  production_progress   Int                     @default(0)
  /// Mảng id `assets` cùng tổ chức — ảnh thành phẩm thợ gửi lên.
  finished_asset_ids    Json?
  /// Ảnh mẫu tải lên lúc tiếp nhận (id `assets`), khi không lấy từ Product Master.
  sample_asset_id       String?
  shipper_name          String?
  shipper_phone         String?
  carrier               String?
  /// PICKED_UP · ON_THE_WAY · DELIVERED_SUCCESS · DELIVERY_FAILED (F12).
  delivery_state        String?
  pod_asset_id          String?
  pod_recipient_name    String?
  pod_captured_at       DateTime?
  partner_payout_vnd    Decimal?                @db.Decimal(14, 2)
  partner_rating        Int?
  closure_notes         String?
  closed_by             String?
  closed_at             DateTime?
  cancelled_reason      String?
  metadata              Json?
  created_at            DateTime                @default(now())
  updated_at            DateTime                @updatedAt

  organization          organizations           @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  order                 orders                  @relation(fields: [order_id], references: [id], onDelete: Cascade)
  partner               partners?               @relation(fields: [partner_id], references: [id])

  @@index([organization_id, stage])
  @@index([organization_id, risk_level])
}

/// Hồ sơ kiểm tra chất lượng sản phẩm hoa cắm (QC). TENANT ISOLATION.
model order_qc_records {
  id               String           @id @default(uuid())
  organization_id  String
  order_id         String
  inspector_id     String?
  status           qc_record_status @default(PENDING)
  /// Điểm chấm AI — CHỈ ghi khi có lượt Vision thật (nợ #140), không nhận từ client.
  ai_score         Int?
  ai_critique      String?
  /// Mảng id `assets` cùng tổ chức — ảnh thành phẩm đã kiểm.
  image_asset_ids  Json?
  checklist_result Json?
  notes            String?
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt

  organization     organizations    @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  order            orders           @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([organization_id, order_id])
}

/// Nhật ký sự cố và ngoại lệ phát sinh trong quá trình điều phối. TENANT ISOLATION.
model order_exceptions {
  id              String   @id @default(uuid())
  organization_id String
  order_id        String
  code            String
  type            String
  severity        String   @default("MEDIUM")
  description     String
  resolution      String?
  status          String   @default("OPEN")
  reported_by     String?
  resolved_by     String?
  resolved_at     DateTime?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization    organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  order           orders        @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, code])
  @@index([organization_id, order_id])
  @@index([organization_id, status])
}

